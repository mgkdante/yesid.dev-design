{
	"name": "yesid-dev-design",
	"version": "0.28.0",
	"private": true,
	"type": "module",
	"description": "yesid.dev brand foundation — tokens, motion, gates, UI, gallery. Parity anchor: yesid.dev @ 2bdb611d91749dc437c07586cb82129eabe9dfec.",
	"packageManager": "bun@1.3.11",
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=22.0.0"
	},
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"api:approve": "bun tools/api-authority.ts approve",
		"api:check": "bun tools/api-authority.ts check",
		"api:report": "bun tools/api-authority.ts report",
		"release:check": "bun tools/release.ts check",
		"release:prepare": "bun tools/release.ts prepare",
		"build": "bun run tokens:build && turbo run build",
		"test": "bun run test:repository && turbo run test",
		"test:repository": "vitest run --config vitest.repository.config.ts",
		"test:browser": "bun run --cwd apps/gallery test:browser",
		"test:browser:list": "bun run --cwd apps/gallery test:browser:list",
		"browser:install": "bun run --cwd apps/gallery browser:install",
		"check": "bun run api:check && tsc --project tsconfig.tools.json && tsc --project tsconfig.repository-tests.json && turbo run check",
		"dev": "turbo run dev",
		"tokens:build": "bun tools/build-tokens.ts",
		"tokens:lint": "design.md lint DESIGN.md",
		"ci:tokens": "bun run tokens:build && git diff --exit-code packages/tokens/tokens.css packages/tokens/theme.css packages/motion/src/tokens.ts DESIGN.md",
		"setup:hooks": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@google/design.md": "0.1.1",
		"@microsoft/api-extractor": "7.58.11",
		"@types/node": "^22.0.0",
		"@yesid/config": "workspace:*",
		"@yesid/motion": "workspace:*",
		"svelte2tsx": "0.7.58",
		"turbo": "^2.5.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0",
		"yaml": "2.9.0"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"cookie": "0.7.2",
		"fast-uri": "3.1.6",
		"nanoid": "3.3.18",
		"postcss": "8.5.26"
	}
}
