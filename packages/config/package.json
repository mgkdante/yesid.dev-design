{
	"name": "@yesid/config",
	"version": "0.30.0",
	"private": true,
	"type": "module",
	"description": "Shared TypeScript, Svelte, Turborepo and Playwright configuration for yesid repositories.",
	"files": [
		"README.md",
		"LICENSE",
		"NOTICE",
		"tsconfig/base.json",
		"tsconfig/library.json",
		"tsconfig/svelte-kit.json",
		"turbo/base.json",
		"svelte/project-runes.js",
		"svelte/project-runes.d.ts",
		"playwright/index.js",
		"playwright/index.d.ts"
	],
	"exports": {
		"./package.json": "./package.json",
		"./tsconfig/base.json": "./tsconfig/base.json",
		"./tsconfig/library.json": "./tsconfig/library.json",
		"./tsconfig/svelte-kit.json": "./tsconfig/svelte-kit.json",
		"./turbo/base.json": "./turbo/base.json",
		"./svelte/project-runes.js": {
			"types": "./svelte/project-runes.d.ts",
			"default": "./svelte/project-runes.js"
		},
		"./playwright": {
			"types": "./playwright/index.d.ts",
			"default": "./playwright/index.js"
		}
	},
	"peerDependencies": {
		"@axe-core/playwright": ">=4.10.0 <5",
		"@playwright/test": ">=1.50.0 <2"
	},
	"peerDependenciesMeta": {
		"@axe-core/playwright": { "optional": true },
		"@playwright/test": { "optional": true }
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1"
	}
}
