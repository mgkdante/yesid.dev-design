{
  "name": "@yesid/tokens",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "description": "DTCG design tokens for yesid products, with generated CSS, the Tailwind theme and bundled fonts. Source of truth: tokens.json.",
  "files": ["src", "fonts", "*.css", "tokens.json", "!**/__tests__", "NOTICE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    "./tokens.json": "./tokens.json",
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css",
    "./fonts": {
      "types": "./src/fonts.ts",
      "default": "./src/fonts.ts"
    },
    "./parse": {
      "types": "./src/parse.ts",
      "default": "./src/parse.ts"
    },
    "./generators/design-md": {
      "types": "./src/generators/design-md.ts",
      "default": "./src/generators/design-md.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  }
}
