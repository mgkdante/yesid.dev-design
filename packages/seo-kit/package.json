{
	"name": "@yesid/seo-kit",
	"version": "0.30.2",
	"private": true,
	"type": "module",
	"description": "Framework-neutral JSON-LD, sitemap and robots, share-card, icon and security-header primitives with consumer-owned policy and rasterization, plus server-side code highlighting.",
	"files": ["src", "fonts", "!**/__tests__", "NOTICE"],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./jsonld": {
			"types": "./src/jsonld.ts",
			"default": "./src/jsonld.ts"
		},
		"./sitemap": {
			"types": "./src/sitemap.ts",
			"default": "./src/sitemap.ts"
		},
		"./og": {
			"types": "./src/og.ts",
			"default": "./src/og.ts"
		},
		"./og/fonts": {
			"types": "./src/og-fonts.ts",
			"default": "./src/og-fonts.ts"
		},
		"./og/files": {
			"types": "./src/og-files.ts",
			"default": "./src/og-files.ts"
		},
		"./icons": {
			"types": "./src/icons.ts",
			"default": "./src/icons.ts"
		},
		"./headers": {
			"types": "./src/headers.ts",
			"default": "./src/headers.ts"
		},
		"./highlight": {
			"types": "./src/highlight.ts",
			"default": "./src/highlight.ts"
		}
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc --noEmit"
	},
	"peerDependencies": {
		"@yesid/tokens": "workspace:*",
		"satori": ">=0.10.0 <1",
		"shiki": ">=4.0.0 <5"
	},
	"peerDependenciesMeta": {
		"shiki": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"satori": "^0.28.0",
		"shiki": "^4.5.0",
		"typescript": "^5.5.0",
		"vitest": "^4.1.0"
	}
}
