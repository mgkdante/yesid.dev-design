#!/usr/bin/env bash
# Pre-commit guard for repository-owned generated token outputs.
#
# GUARD 1: staging any GENERATED token output without staging a matching token
# SOURCE fails the commit. For app.css, only changes to the generated sentinel
# region count; hand-maintained regions remain independently editable.
#
# Opt in once per clone: `bun run setup:hooks` (git config core.hooksPath .githooks)

set -euo pipefail

HOOK_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
FULLY_GENERATED_RE='^(packages/tokens/tokens\.css|packages/motion/src/tokens\.ts|DESIGN\.md)$'
SOURCE_RE='^(packages/tokens/(tokens\.json|src/.*\.ts)|packages/ui/(package\.json|src/brand/index\.ts)|tools/build-tokens\.ts)$'
APP_CSS='apps/gallery/src/app.css'
START='/* ===== TOKENS:START ===== */'
END='/* ===== TOKENS:END ===== */'

sentinel_region() {
	local object=$1

	git show "$object" | awk -v start="$START" -v end="$END" '
		BEGIN { inside = 0; saw_start = 0; saw_end = 0; valid = 1 }
		$0 == start {
			if (saw_start || saw_end) valid = 0
			saw_start = 1
			inside = 1
		}
		inside { print }
		$0 == end {
			if (!inside || !saw_start || saw_end) valid = 0
			saw_end = 1
			inside = 0
		}
		END {
			if (!valid || !saw_start || !saw_end || inside) exit 1
		}
	'
}

app_sentinel_changed() {
	local head_hash
	local index_hash

	if ! git cat-file -e "HEAD:$APP_CSS" 2>/dev/null; then
		git cat-file -e ":$APP_CSS" 2>/dev/null
		return
	fi
	if ! git cat-file -e ":$APP_CSS" 2>/dev/null; then
		return 0
	fi
	if ! head_hash=$(sentinel_region "HEAD:$APP_CSS" | git hash-object --stdin); then
		return 0
	fi
	if ! index_hash=$(sentinel_region ":$APP_CSS" | git hash-object --stdin); then
		return 0
	fi
	[[ "$head_hash" != "$index_hash" ]]
}

sentinel_sides() {
	local object=$1
	local scope=$2

	git show "$object" | awk -v start="$START" -v end="$END" -v scope="$scope" '
		BEGIN { side = "B"; inside = 0 }
		$0 == start { inside = 1; next }
		$0 == end { inside = 0; side = "A"; next }
		!inside {
			line = $0
			sub(/^[[:space:]]+/, "", line)
			sub(/[[:space:]]+$/, "", line)
			if (line != "") print scope "|" side "|" line
		}
	'
}

app_content_crossed_sentinel() {
	{
		sentinel_sides "HEAD:$APP_CSS" H
		sentinel_sides ":$APP_CSS" I
	} | awk '
		{
			scope = substr($0, 1, 1)
			side = substr($0, 3, 1)
			line = substr($0, 5)
			count[scope side, line] += 1
			lines[line] = 1
		}
		END {
			for (line in lines) {
				before_delta = count["IB", line] - count["HB", line]
				after_delta = count["IA", line] - count["HA", line]
				if (before_delta > 0 && after_delta < 0) exit 0
				if (before_delta < 0 && after_delta > 0) exit 0
			}
			exit 1
		}
	'
}

app_sentinel_markers_changed() {
	git diff \
		--cached \
		--no-ext-diff \
		--no-textconv \
		--no-renames \
		--unified=0 \
		HEAD \
		-- \
		"$APP_CSS" |
		grep -qE '^[+-]/\* ===== TOKENS:(START|END) ===== \*/$'
}

# --no-renames keeps both sides of a staged rename visible, including a
# generated file renamed away from its protected path.
staged_paths=$(git diff --cached --name-only --no-renames --)
generated_change=false

if grep -qxF "$APP_CSS" <<< "$staged_paths"; then
	if ! git show ":$APP_CSS" 2>/dev/null | bun "$HOOK_ROOT/tools/app-css-token-layout.ts"; then
		exit 1
	fi
fi

if grep -qE "$FULLY_GENERATED_RE" <<< "$staged_paths"; then
	generated_change=true
elif grep -qxF "$APP_CSS" <<< "$staged_paths"; then
	if app_sentinel_changed || app_sentinel_markers_changed || app_content_crossed_sentinel; then
		generated_change=true
	fi
fi

if [[ "$generated_change" == true ]]; then
	if ! grep -qE "$SOURCE_RE" <<< "$staged_paths"; then
		echo "✗ pre-commit GUARD 1: generated token output staged without a token source change." >&2
		echo "  Generated files (package tokens.css / app.css sentinel region / motion tokens.ts / DESIGN.md)" >&2
		echo "  are owned by the root token build — edit its source inputs and run" >&2
		echo "  \`bun run tokens:build\`, then stage source + outputs together." >&2
		exit 1
	fi
fi

exit 0
